{
  "name": "party-dev",
  "compatibility_date": "2026-09-01",
  "main": "worker/index.ts",
  "assets": {
    // `directory` is intentionally omitted here.
    // @cloudflare/vite-plugin populates it automatically with the client build
    // output path (dist/client) when it generates dist/party-dev/wrangler.json.
    "not_found_handling": "single-page-application",
    // Only run this Worker's own fetch handler for /api/* and /ws/* — every
    // other path (including deep-linked SPA routes like /m/ABCDEF) goes
    // straight to the assets handler, which applies not_found_handling above
    // instead of falling through to Hono's default 404. /ws/* is needed
    // for the WebSocket upgrade route — without it,
    // requests to /ws/* never reach the Worker at all.
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  "durable_objects": {
    // MATCH holds one multiplayer match per object; DAILY one player's run at
    // one daily game on one day (worker/daily.ts).
    "bindings": [
      { "name": "MATCH", "class_name": "MatchDO" },
      { "name": "DAILY", "class_name": "DailyDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["MatchDO"] },
    { "tag": "v2", "new_sqlite_classes": ["DailyDO"] }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "party",
      "database_id": "REPLACE_ME_SEE_README"
    }
  ],
  // The base URL nudge messages link back to
  // (`<PUBLIC_BASE_URL>/m/<code>`). This committed value is a localhost
  // default for local dev only — production MUST override it (edit this
  // value before deploying, or pass `wrangler deploy --var
  // PUBLIC_BASE_URL:https://your-real-domain`), or real nudges will link to
  // localhost. `SLACK_WEBHOOK_URL` is deliberately not here: it is a secret
  // (see `.dev.vars.example` for local dev and the README operator
  // checklist for `wrangler secret put SLACK_WEBHOOK_URL`).
  "vars": { "PUBLIC_BASE_URL": "http://localhost:5173" },
  // Hourly lobby sweep (worker/sweep.ts): arms the expiry alarm of any old
  // lobby that has none, a batch at a time. Mondays at 08:00 UTC, the weekly
  // recap to Slack (worker/recap.ts, whose RECAP_CRON must match it).
  "triggers": { "crons": ["0 * * * *", "0 8 * * 1"] },
  "observability": { "enabled": true }
}
