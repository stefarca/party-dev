{
  "compilerOptions": {
    "composite": true,
    "target": "es2022",
    "lib": ["es2022", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["web/**/*.ts", "web/**/*.tsx", "shared/**/*.ts", "games/**/*.ts", "games/**/*.tsx"]
}
