SESSION_SECRET=replace-with-a-long-random-string
# Slack incoming-webhook URL for turn nudges. Optional: leave unset
# (or delete this line) for local dev — worker/nudge.ts no-ops cleanly, with
# no error, when it is missing. Never commit a real value.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE/ME/DUMMY
# Web push (VAPID). Optional as a set: worker/push.ts sends nothing, and the
# app shows no notification control, unless all three are present. The pair
# below is a throwaway generated for this file — it is not used by any
# deployment, and its private half being public costs nothing, because a push
# subscription made against it exists only in the browser that made it.
# Generate your own for production (see the README) and set them with
# `wrangler secret put`; never commit those.
VAPID_PUBLIC_KEY=BHWzNeIu4E-Rbf0iXCXy1G1W2mHK7Nx8fVdtmQrTue-H-sqgdW7tj66K-nYGw0t0URT7GX2z6QlZuVnsHkUoZlo
VAPID_PRIVATE_KEY=NPMBjm9H92GwU6yQwZrWXc0MTFeZ4TWU1lNAaOvYZUc
VAPID_SUBJECT=mailto:replace-me@example.com
